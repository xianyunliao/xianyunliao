          </geometry>

          <material>
            <ambient>0.45 0.25 0.1 1</ambient>
            <diffuse>0.45 0.25 0.1 1</diffuse>
          </material>

        </visual>

      </link>
    </model>


    <!-- ================================================= -->
    <!--                   Extra Blocks                     -->
    <!-- ================================================= -->

    <model name="small_block_1">
      <static>true</static>
      <pose>-0.5 2.8 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
