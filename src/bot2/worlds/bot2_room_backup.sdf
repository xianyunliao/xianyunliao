    </model>


    <!-- ================================================= -->
    <!--                    GUI                             -->
    <!-- ================================================= -->

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>15 -15 14 0 0 0.75</pose>
      </camera>
    </gui>

  
    <!-- TurtleBot3 Burger -->
    <include>
      <uri>model://turtlebot3_burger</uri>
      <name>burger</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

</world>

</sdf>
